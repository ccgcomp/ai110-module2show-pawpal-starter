classDiagram
    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +mark_complete() None
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +get_tasks() list~Task~
    }

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) None
        +get_all_tasks() list~tuple~Pet, Task~~
    }

    class Scheduler {
        +Owner owner
        +get_todays_schedule() list~tuple~Pet, Task~~
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : uses
